VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_GOOGLE_AI_API_KEY=
VITE_GOOGLE_AI_MODEL=gemini-3.6-flash

# Demo auth is useful for local showcases only. Keep this false in production.
VITE_ENABLE_DEMO_AUTH=false

# Browser OpenAI keys are exposed to site visitors. Prefer a backend proxy.
VITE_OPENAI_API_KEY=
VITE_ALLOW_BROWSER_OPENAI=false
